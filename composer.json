{
    "name": "vusys/exocomp",
    "description": "Agent-first PHP code intelligence: named addressing, one-shot whole answers, dense token-budgeted output.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "static-analysis",
        "code-intelligence",
        "refactoring",
        "cli",
        "agent"
    ],
    "authors": [
        {
            "name": "Bryan",
            "email": "bryan@vuii.co.uk",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Vusys/exocomp/issues",
        "source": "https://github.com/Vusys/exocomp"
    },
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.6",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "infection/extension-installer": "^0.1.2",
        "infection/infection": "^0.34.2",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vusys\\Exocomp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vusys\\Exocomp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/exocomp"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "analyze": "@analyse",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "pint": "pint",
        "pint:check": "pint --test",
        "check": [
            "@pint:check",
            "@rector:check",
            "@analyse"
        ],
        "test": "phpunit",
        "infection": "infection --threads=max"
    }
}
