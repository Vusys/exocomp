{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "github": true
    },
    "mutators": {
        "@default": true
    },
    // Measured on the first Phase 0 commit: 80% MSI over 1,031 mutants. The source has since
    // grown roughly eightfold, and the thresholds were re-set once — a drop, recorded as one —
    // to sit below the 73.3% a clean run over Phases 0-3 measured.
    //
    // Phase 4 then took it to 69.35% (5,772 mutants), and this time the escapes were not
    // diffuse: 840 of 1,769 sat in the framework readers, which had been tested end to end
    // through the CLI and so asserted that a string appeared somewhere rather than that a column
    // had the right type on the right line. Unit tests for those readers took it to 71.57% and
    // then to **72.82%** on the committed tree, and found four real defects on the way — a route
    // losing its name, a column type printed in a spelling the framework does not have, a PHP
    // warning leaking into the output, and a dead branch behind an unimported class name.
    //
    // The threshold stays at 71 rather than being ratcheted to the measured figure. Ratcheting
    // to within a point of the measurement makes the next commit a coin toss rather than a
    // check; it goes up when there is room to raise it to.
    "minMsi": 71,
    "minCoveredMsi": 71
}
