{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "github": true
    },
    "mutators": {
        "@default": true
    },
    // Measured on the first Phase 0 commit: 80% MSI over 1,031 mutants. The source has since
    // grown roughly eightfold, and the thresholds were re-set once — a drop, recorded as one —
    // to sit below the 73.3% a clean run over Phases 0-3 measured.
    //
    // Phase 4 then took it to 69.35% (5,772 mutants), and this time the escapes were not
    // diffuse: 840 of 1,769 sat in the framework readers, which had been tested end to end
    // through the CLI and so asserted that a string appeared somewhere rather than that a column
    // had the right type on the right line. Unit tests for those readers took it to 71.57% and
    // then to 72.82% on the committed tree, and found four real defects on the way — a route
    // losing its name, a column type printed in a spelling the framework does not have, a PHP
    // warning leaking into the output, and a dead branch behind an unimported class name.
    //
    // Phase 5 repeated the pattern exactly. The graph layer landed at 71.85% (6,703 mutants)
    // with 83 escapes in one row-rendering expression nothing checked the shape of, and the
    // same remedy — assert the record, not that a substring appeared — took it to 72.85%.
    // Reading what was still escaping in the walk then turned up a loop guard that could never
    // fire, and removing it rather than defending against an impossible cycle gave **73.24%**
    // (4,910 of 6,704) on the committed tree.
    //
    // Raised from 71 to 72 here — the first ratchet up in this project, and it is earned rather
    // than aspirational: two consecutive phases have finished above 72.8. It leaves about 1.2
    // points of headroom, which is roughly eighty mutants, so a commit that adds a couple of
    // hundred lines of lightly tested code will trip it. That is the gate working. The reason
    // not to go to 73 is the one that kept it at 71 before: a threshold within a point of the
    // measurement makes the next commit a coin toss rather than a check.
    //
    // `timeout` is raised from Infection's default of 10 seconds because that number is also a
    // filter: a mutant whose covering tests take longer than it to run is skipped, not tested.
    // On CI's runner (one thread, xdebug) 1,130 of 8,108 mutants were skipped that way at 0.3.0,
    // which put the score at 71.61% and failed the gate; the same tree measured 75.82% locally,
    // where none were. A threshold that moves with the runner's speed is not measuring the tests.
    "timeout": 60,
    "minMsi": 72,
    "minCoveredMsi": 72
}
